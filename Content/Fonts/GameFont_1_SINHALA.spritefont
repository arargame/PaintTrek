<?xml version="1.0" encoding="utf-8"?>
<!--
  GameFont_1_SINHALA.spritefont
  OTOMATIK URETILDI — tools/font/filter_nonlatin_characters.py
  ELLE DUZENLEME. Dil eklendiginde/degistiginde scripti yeniden calistir.

  Varyant : _SINHALA  (si)
  Kaynak  : NotoSansSinhala-Shaped.ttf
  Karakter: 3 (ASCII 0x20-0x7E haric)
-->
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>NotoSansSinhala-Shaped</FontName>
    <Size>14</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <DefaultCharacter>?</DefaultCharacter>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#x20;</Start>
        <End>&#x7E;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#xE162;</Start>
        <End>&#xE162;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#xE1B9;</Start>
        <End>&#xE1B9;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#xE1C1;</Start>
        <End>&#xE1C1;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
