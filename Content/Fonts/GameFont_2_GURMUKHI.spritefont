<?xml version="1.0" encoding="utf-8"?>
<!--
  GameFont_2_GURMUKHI.spritefont
  OTOMATIK URETILDI — tools/font/filter_nonlatin_characters.py
  ELLE DUZENLEME. Dil eklendiginde/degistiginde scripti yeniden calistir.

  Varyant : _GURMUKHI  (pa)
  Kaynak  : NotoSansGurmukhi-Shaped.ttf
  Karakter: 3 (ASCII 0x20-0x7E haric)
-->
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>NotoSansGurmukhi-Shaped</FontName>
    <Size>20</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <DefaultCharacter>?</DefaultCharacter>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#x20;</Start>
        <End>&#x7E;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#xE05F;</Start>
        <End>&#xE05F;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#xE0EA;</Start>
        <End>&#xE0EA;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#xE0FF;</Start>
        <End>&#xE0FF;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
