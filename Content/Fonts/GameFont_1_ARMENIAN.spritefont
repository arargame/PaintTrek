<?xml version="1.0" encoding="utf-8"?>
<!--
  GameFont_1_ARMENIAN.spritefont
  OTOMATIK URETILDI — tools/font/filter_nonlatin_characters.py
  ELLE DUZENLEME. Dil eklendiginde/degistiginde scripti yeniden calistir.

  Varyant : _ARMENIAN  (hy)
  Kaynak  : NotoSansArmenian-Merged.ttf
  Karakter: 6 (ASCII 0x20-0x7E haric)
-->
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>NotoSansArmenian-Merged</FontName>
    <Size>14</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <DefaultCharacter>?</DefaultCharacter>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#x20;</Start>
        <End>&#x7E;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#x540;</Start>
        <End>&#x540;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#x561;</Start>
        <End>&#x561;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#x565;</Start>
        <End>&#x565;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#x575;</Start>
        <End>&#x575;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#x576;</Start>
        <End>&#x576;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#x580;</Start>
        <End>&#x580;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
